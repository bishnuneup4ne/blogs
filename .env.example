# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=images

# Public origin of this blog — used for canonical URLs, RSS, sitemap and
# newsletter links. Set per deployment (the apex domain is the portfolio).
NEXT_PUBLIC_SITE_URL=https://blogs.bishnuneupane13.com.np

# Admin studio password (signs the admin_auth cookie). No quotes around the value.
PAGE_ACCESS_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Resend (optional — newsletter sends)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Newsletter <you@example.com>
