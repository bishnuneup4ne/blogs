# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=images

# Admin studio password (signs the admin_auth cookie). No quotes around the value.
PAGE_ACCESS_PASSWORD=change-me

# Resend (optional — newsletter sends)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Newsletter <you@example.com>
